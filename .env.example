FLASK_ENV=development
SECRET_KEY=replace_with_secure_random_value
CODING_DASHBOARD=replace_with_local_dashboard_key

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGO_USERNAME=admin
MONGO_PASSWORD=replace_with_dummy_password
MONGODB_DATABASE=platform_db
REDIS_URL=redis://localhost:6379/0

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_dummy_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_dummy_webhook_secret

# Lead extractor settings
MAX_LEADS_PER_JOB=500

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@example.com
SMTP_PASSWORD=replace_with_dummy_app_password
SMTP_FROM_NAME=Lead Gen Platform
